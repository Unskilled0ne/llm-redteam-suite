# ==============================================================================
# FinCorp AI Enterprise Assistant - Production Environment Configuration
# ==============================================================================

# Application Environment (production, staging, development)
APP_ENV=production

# Server Binding
HOST=0.0.0.0
PORT=8000

# Security & Guardrail Configuration
DEFAULT_DEFENSE_MODE=hardened
ALLOW_INSECURE_MODE=false
CANARY_TOKEN=CANARY_TOKEN_99814_CONFIDENTIAL

# LLM Provider Configuration
# Options: simulation, openai, gemini, ollama
LLM_PROVIDER=simulation
LLM_MODEL=gpt-4o-mini

# OpenAI / OpenAI-Compatible Provider (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini Provider (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Ollama Local Provider (Required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
